// Prisma schema for the Telugu captioning app.
// Phase 1 uses SQLite (zero-config, local). Phase 2 swaps `provider` to "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One uploaded video and its processing lifecycle.
model Job {
  id           String   @id @default(cuid())
  status       String   @default("queued") // queued | extracting | transcribing | done | failed
  progress     Int      @default(0) //  0..100
  provider     String   @default("mock") // which ASR provider ran (mock | sarvam | openai)
  language     String? //  detected language code, e.g. "te"
  error        String? //  failure reason, if status = failed
  originalName String? //  the user's original filename
  videoKey     String? //  storage key for the uploaded video (e.g. uploads/<id>/source.mp4)
  durationSec  Float? //   media duration in seconds
  width        Int? //     video pixel width  (detected from the upload; drives the preview/export aspect ratio)
  height       Int? //     video pixel height
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Prepaid minutes reserved/deducted for this job (0 if monthly quota covered it).
  creditReservedMin Float @default(0)

  transcript Transcript?

  @@index([userId])
}

/// The generated subtitle segments for a job (stored as JSON).
model Transcript {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  language  String?
  segments  String //   JSON-serialized Segment[] (start, end, text, words[])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// User-saved subtitle style presets (built-in presets also live in code).
model StylePreset {
  id        String   @id @default(cuid())
  name      String
  style     String //   JSON-serialized SubtitleStyle
  createdAt DateTime @default(now())
}

/// A user's custom spelling correction: replace whole-word `from` with `to` in transcripts.
model SpellingRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      String //  the (mis)spelling the ASR tends to produce
  to        String //  the correction to substitute
  createdAt DateTime @default(now())

  @@unique([userId, from])
  @@index([userId])
}

// --- Auth.js (NextAuth) models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  /// free | creator | pro — drives monthly minute / concurrency quotas
  plan                 String  @default("free")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  stripePriceId        String?

  accounts            Account[]
  sessions            Session[]
  jobs                Job[]
  spellingRules       SpellingRule[]
  styleAnalyses       StyleAnalysis[]
  savedStyles         SavedStyle[]
  generationLogs      GenerationLog[]
  styleRequests       StyleRequest[]
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]
  creditPurchases     CreditPurchase[]
}

/// Prepaid caption-minute wallet. Never expires; accumulates across purchases.
model CreditBalance {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableMinutes Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Ledger for caption minutes (free grant, usage, refund, admin adjustment).
model CreditTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // GRANT | PURCHASE | USAGE | REFUND | ADJUSTMENT
  minutes       Float
  balanceBefore Float
  balanceAfter  Float
  paymentId     String?
  orderId       String?
  videoId       String?
  description   String?
  status        String   @default("COMPLETED") // COMPLETED | RESERVED | RELEASED
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([videoId])
}

/// One Stripe Checkout (one-time) attempt to buy a prepaid pack.
model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId          String
  minutes         Float
  amount          Int      @default(0)
  currency        String   @default("inr")
  paymentProvider String   @default("stripe")
  paymentId       String?  @unique
  orderId         String?  @unique
  status          String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// --- Caption Style Analyzer ---

/// One screenshot analysis: the extracted StyleProfile + the derived SubtitleStyle. Also
/// serves as the per-user monthly analyze-quota ledger (one row per successful vision call).
model StyleAnalysis {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageKey      String? //  storage key for the uploaded screenshot
  provider      String //   which vision provider produced it (mock | anthropic)
  profile       String //   JSON-serialized StyleProfile (incl. fontMatch)
  subtitleStyle String //   JSON-serialized SubtitleStyle (render-ready)
  ocrText       String? //  optional caption text, off by default
  confidence    Float
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

/// A user-saved caption style ("My Styles"): the match key (profile) + the render-ready style.
model SavedStyle {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  profile        String //   JSON-serialized StyleProfile — used for similarity matching
  subtitleStyle  String //   JSON-serialized SubtitleStyle — render-ready
  sourceImageKey String? //  storage key of the screenshot it came from, if any
  confidence     Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// Per-user monthly caption-generation ledger (one row per successful generate call).
model GenerationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Creator request: recreate a caption style from a reference screenshot/video within ~24h.
model StyleRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String //   short label for the look they want
  platform      String? //  where they saw it (Instagram, YouTube, etc.)
  notes         String? //  extra detail: fonts, colors, motion, creator name
  referenceKey  String? //  storage key for screenshot/video
  referenceName String? //  original filename
  referenceType String? //  mime type
  referenceUrl  String? //  optional external/Blob URL if not stored locally
  status        String   @default("open") // open | in_progress | done | declined
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
