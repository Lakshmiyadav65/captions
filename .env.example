# Copy to .env (or .env.local) and fill in. Local defaults need zero infrastructure.

# ---- Database ----
# Local: SQLite. Production: a postgresql:// URL.
DATABASE_URL="file:./dev.db"

# ---- Transcription ----
# auto | sarvam | openai | mock   (auto = use whichever key is set, prefer Sarvam)
ASR_PROVIDER=auto
# te = force Telugu (best accuracy); auto = detect spoken language
ASR_LANGUAGE=te
# Subtitle output: translit = romanized (Telugu in English letters); transcribe = Telugu script
OUTPUT_MODE=translit
# Sarvam (recommended for Telugu): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Caption Style Analyzer (vision) ----
# auto | anthropic | mock   (auto = use Anthropic when ANTHROPIC_API_KEY is set, else mock)
VISION_PROVIDER=auto
# Anthropic key: https://console.anthropic.com  (leave blank to use the keyless mock)
ANTHROPIC_API_KEY=
# Vision model for screenshot analysis. sonnet = best value; haiku = cheapest; opus = max quality.
VISION_MODEL=claude-sonnet-5
# AI caption generation.  auto | claude | mock
CAPTION_PROVIDER=auto
# Model for AI caption generation (cheap).
GENERATE_MODEL=claude-haiku-4-5
# OCR the caption text too? Off = one vision call per analysis; on = a second paid call.
OCR_ENABLED=false
MAX_IMAGE_MB=10
QUOTA_MONTHLY_ANALYSES=50
QUOTA_MONTHLY_GENERATIONS=100
STYLE_MATCH_THRESHOLD=0.9

# ---- Storage ----  local | s3
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3 (AWS S3 / Cloudflare R2 / MinIO):
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=            # set for R2/MinIO; leave blank for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=     # optional CDN/public base for object GETs

# ---- Job queue ----  inline | bullmq
QUEUE_DRIVER=inline
# Required for bullmq (run `npm run worker` as a separate process):
REDIS_URL=

# ---- Auth ----
AUTH_ENABLED=false
AUTH_SECRET=            # required in prod: openssl rand -hex 32
AUTH_DEV_LOGIN=true     # email-only dev sign-in; set false in production
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Guardrails / quotas ----
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=30
QUOTA_MONTHLY_MINUTES=120
QUOTA_MAX_ACTIVE_JOBS=3
