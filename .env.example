# Copy to .env (or .env.local) and fill in. Local defaults need zero infrastructure.

# ---- Database ----
# Local: SQLite. Production: a postgresql:// URL.
DATABASE_URL="file:./dev.db"

# ---- Transcription ----
# auto | sarvam | openai | mock   (auto = use whichever key is set, prefer Sarvam)
ASR_PROVIDER=auto
# te = force Telugu (best accuracy); auto = detect spoken language
ASR_LANGUAGE=te
# Subtitle output: translit = romanized (Telugu in English letters); transcribe = Telugu script
OUTPUT_MODE=translit
# Sarvam (recommended for Telugu): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional karaoke refine: keep Sarvam/primary text, attach Whisper word times (~$/min)
# none | openai
TIMING_PROVIDER=none

# ---- Caption Style Analyzer (vision) ----
# auto | anthropic | mock   (auto = use Anthropic when ANTHROPIC_API_KEY is set, else mock)
VISION_PROVIDER=auto
# Anthropic key: https://console.anthropic.com  (leave blank to use the keyless mock)
ANTHROPIC_API_KEY=
# Vision model for screenshot analysis. sonnet = best value; haiku = cheapest; opus = max quality.
VISION_MODEL=claude-sonnet-5
# AI caption generation.  auto | claude | mock
CAPTION_PROVIDER=auto
# Model for AI caption generation (cheap).
GENERATE_MODEL=claude-haiku-4-5
# OCR the caption text too? Off = one vision call per analysis; on = a second paid call.
OCR_ENABLED=false
MAX_IMAGE_MB=10
QUOTA_MONTHLY_ANALYSES=50
QUOTA_MONTHLY_GENERATIONS=100
STYLE_MATCH_THRESHOLD=0.9

# ---- Storage ----  local | s3
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3 (AWS S3 / Cloudflare R2 / MinIO):
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=            # set for R2/MinIO; leave blank for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=     # optional CDN/public base for object GETs
# Vercel Blob (recommended on Vercel Hobby): durable uploads + burned MP4 downloads.
# Create a Blob store in the Vercel project — token is injected automatically as BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# ---- Job queue ----  inline | bullmq
QUEUE_DRIVER=inline
# Required for bullmq (run `npm run worker` as a separate process):
REDIS_URL=

# ---- Auth ----
# Local demo: AUTH_ENABLED=false (no sign-in). Audience / production:
# AUTH_ENABLED=true, AUTH_DEV_LOGIN=false, AUTH_GOOGLE_ID/SECRET set, AUTH_URL=https://your.domain
AUTH_ENABLED=false
AUTH_SECRET=            # required in prod: openssl rand -hex 32
AUTH_DEV_LOGIN=true     # email-only sign-in; MUST be false in production
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Public site URL (Auth.js + billing). Production example: https://captions-gilt.vercel.app
# AUTH_URL=
STRICT_PROD_AUTH=false  # set true in prod after Google OAuth is configured

# ---- Guardrails / quotas ----
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=30
QUOTA_MONTHLY_MINUTES=120
QUOTA_MAX_ACTIVE_JOBS=3
# Upload abuse limits (Redis if REDIS_URL set, else in-memory)
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=30

# ---- Billing (optional; free demo for soft launch) ----
# Soft launch: leave payment keys empty — everyone stays on Free quotas above.
# When charging: use Razorpay (not Stripe). Wire keys + plan ids then.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_CREATOR=
# RAZORPAY_PLAN_PRO=
# Legacy Stripe vars (unused — do not set):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_PRO=
# Public site URL for Checkout success/cancel + Customer Portal return
APP_URL=http://localhost:3000

# ---- Observability (Phase 4) ----
# Optional Sentry DSN — job/upload failures are POSTed when set
SENTRY_DSN=
SENTRY_ENVIRONMENT=          # e.g. staging | production
SENTRY_RELEASE=              # e.g. git sha
# Set true on real staging/prod: blocks AUTH_DEV_LOGIN + weak AUTH_SECRET
STRICT_PROD_AUTH=false
